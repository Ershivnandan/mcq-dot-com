# MongoDB Connection String (Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mcq_quiz_manager?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://username:password@cluster0.mongodb.net/mcq_quiz_manager?retryWrites=true&w=majority"

# Authentication Secret (Used for session token signing and hashing)
AUTH_SECRET="change-this-to-a-secure-random-string-at-least-32-chars-long"

# AES-256-GCM Encryption Key (Must be exactly 64 hex characters / 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
