datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  PRACTICE
  EXAM
}

enum AIProviderType {
  GEMINI
  OPENAI
  ANTHROPIC
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

type QuestionOption {
  id          String  @default(cuid())
  optionText  String
  optionOrder Int
  isCorrect   Boolean @default(false)
}

type QuestionAttemptAnswer {
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean @default(false)
  timeSpentSeconds Int     @default(0)
}

model User {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  email            String             @unique
  passwordHash     String
  name             String?
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  preference       UserPreference?
  aiConfigs        AIProviderConfig[]
  aiUsageLogs      AIUsageLog[]
  topics           Topic[]
  categories       Category[]
  tags             Tag[]
  collections      Collection[]
  questions        Question[]
  quizzes          Quiz[]
  quizAttempts     QuizAttempt[]
  questionProgress QuestionProgress[]
  draftQuestions   AIDraftQuestion[]
  sessions         Session[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreference {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @unique @db.ObjectId
  theme                String   @default("system") // light, dark, system, oled, sepia
  defaultQuizMode      QuizMode @default(PRACTICE)
  defaultQuestionCount Int      @default(20)
  shuffleOptions       Boolean  @default(true)
  shuffleQuestions     Boolean  @default(true)
  spacedRepetition     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIProviderConfig {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  userId       String         @db.ObjectId
  provider     AIProviderType
  encryptedKey String         // AES-256-GCM encrypted
  iv           String
  tag          String
  defaultModel String
  isDefault    Boolean        @default(false)
  isEnabled    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model AIUsageLog {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  provider         AIProviderType
  model            String
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int
  questionCount    Int            @default(0)
  status           String         // SUCCESS, FAILED
  errorMessage     String?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Topic {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  name        String
  slug        String
  description String?
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  Category[]
  questions   Question[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  topicId     String?    @db.ObjectId
  name        String
  slug        String
  color       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions   Question[]

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  name        String
  slug        String
  color       String?
  questionIds String[]   @db.ObjectId
  questions   Question[] @relation(fields: [questionIds], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Collection {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  name        String
  description String?
  color       String?
  questionIds String[]   @db.ObjectId
  questions   Question[] @relation(fields: [questionIds], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Question {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @db.ObjectId
  questionText  String
  explanation   String?
  difficulty    Difficulty         @default(MEDIUM)
  questionDate  DateTime?          // Exam/Origin date (e.g. 2026-05-01)
  source        String?
  notes         String?
  isFavorite    Boolean            @default(false)
  isArchived    Boolean            @default(false)
  topicId       String?            @db.ObjectId
  categoryId    String?            @db.ObjectId
  tagIds        String[]           @db.ObjectId
  tags          Tag[]              @relation(fields: [tagIds], references: [id])
  collectionIds String[]           @db.ObjectId
  collections   Collection[]       @relation(fields: [collectionIds], references: [id])
  options       QuestionOption[]
  progress      QuestionProgress?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, questionDate])
  @@index([userId, createdAt])
  @@index([userId, topicId])
  @@index([userId, categoryId])
  @@index([userId, difficulty])
  @@index([userId, isFavorite])
  @@index([userId, isArchived])
}

model QuestionProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  questionId     String    @unique @db.ObjectId
  attemptCount   Int       @default(0)
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  accuracy       Float     @default(0.0)
  lastAttemptAt  DateTime?
  lastCorrectAt  DateTime?
  currentStreak  Int       @default(0)
  nextReviewAt   DateTime?
  masteryLevel   Int       @default(0) // 0 to 5 (SuperMemo scale)
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
  @@index([userId, accuracy])
}

model Quiz {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  title            String
  description      String?
  mode             QuizMode      @default(PRACTICE)
  timeLimitMinutes Int?
  shuffleQuestions Boolean       @default(true)
  shuffleOptions   Boolean       @default(true)
  showExplanations Boolean       @default(true)
  questionIds      String[]      @db.ObjectId
  totalQuestions   Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts         QuizAttempt[]

  @@index([userId, createdAt])
}

model QuizAttempt {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId           String                  @db.ObjectId
  quizId           String?                 @db.ObjectId
  title            String
  mode             QuizMode
  totalQuestions   Int
  correctCount     Int                     @default(0)
  incorrectCount   Int                     @default(0)
  unansweredCount  Int                     @default(0)
  score            Float                   @default(0.0)
  accuracy         Float                   @default(0.0)
  timeTakenSeconds Int                     @default(0)
  answers          QuestionAttemptAnswer[]
  completedAt      DateTime                @default(now())
  createdAt        DateTime                @default(now())

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz             Quiz?                   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
}

model AIDraftQuestion {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       String      @db.ObjectId
  prompt       String
  questionText String
  optionsJson  Json        // [{ text: string, isCorrect: boolean }]
  explanation  String?
  topic        String?
  category     String?
  difficulty   Difficulty  @default(MEDIUM)
  tagsJson     Json?       // string[]
  relatedJson  Json?       // string[]
  status       DraftStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
